{
  "name": "nexusflow-backend",
  "version": "1.0.0",
  "description": "NexusFlow IoT Telemetry Ingestion and Rule Engine Backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "mock": "node scripts/mockSensor.js",
    "test": "node scripts/testAuth.js && node scripts/testIngest.js && node scripts/testWeek2Compiler.js && node --test tests/compiler.test.js && node --test tests/ruleRunner.test.js && node --test tests/hardening.test.js && node --test tests/actionDispatcher.test.js && node --test tests/activityTracker.test.js",
    "test:unit": "node --test tests/compiler.test.js tests/ruleRunner.test.js tests/hardening.test.js tests/actionDispatcher.test.js tests/activityTracker.test.js",
    "test:auth": "node scripts/testAuth.js",
    "test:ingest": "node scripts/testIngest.js",
    "test:compiler": "node --test tests/compiler.test.js",
    "test:runner": "node --test tests/ruleRunner.test.js",
    "test:hardening": "node --test tests/hardening.test.js",
    "test:actions": "node --test tests/actionDispatcher.test.js",
    "test:activity": "node --test tests/activityTracker.test.js",
    "test:graph": "node scripts/testWeek2Compiler.js",
    "smoke": "node scripts/e2eSmoke.js",
    "lint": "eslint src/ tests/ scripts/",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\"",
    "loadtest": "node scripts/loadTest.js",
    "storage:stats": "node scripts/storageStats.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "rxjs": "^7.8.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.10.1"
  }
}
