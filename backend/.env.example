# NexusFlow Backend Environment Configuration

# Server Port
PORT=5000

# Node.js Environment (development | production | test)
NODE_ENV=development

# MongoDB Connection String (MongoDB 5.0+ or MongoDB Atlas required for Time-Series collections)
MONGO_URI=mongodb://localhost:27017/nexusflow

# JWT Authentication Configuration
JWT_SECRET=nexusflow_jwt_secret_key_production_random_string_change_me
JWT_EXPIRES_IN=7d

# Optional: Ingestion API Key (Require 'x-api-key' header on POST /api/ingest and /api/ingest/batch)
# Leave blank for open IoT device ingestion
INGEST_API_KEY=

# Optional: Ingestion Rate Limit (requests/min, e.g. 10000, or 'unlimited' for stress tests)
# Default is 10000 requests per minute
INGEST_RATE_LIMIT=unlimited

# Optional: Automated Telemetry TTL Retention (in days)
# Automatically expires and deletes time-series buckets older than N days via MongoDB TTL
# Leave unset or empty to retain telemetry indefinitely
TELEMETRY_RETENTION_DAYS=30

# Optional: Base URL used by internal test scripts (testAuth, testIngest, e2eSmoke, loadTest)
API_URL=http://localhost:5000
